#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraude
:AlerteFraude rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty :triggersRule ;
                                owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                owl:onClass :Regle
                              ] ;
              rdfs:comment "Alerte générée lors de la détection d'une fraude." ;
              rdfs:label "Alerte de Fraude" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeCumul
:AlerteFraudeCumul rdf:type owl:Class ;
                   rdfs:subClassOf :AlerteFraude ;
                   rdfs:comment "Cumul journalier dépassé, >10000 MAD/jour (R005)." ;
                   rdfs:label "Alerte Fraude Cumul" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeFrequence
:AlerteFraudeFrequence rdf:type owl:Class ;
                       rdfs:subClassOf :AlerteFraude ;
                       rdfs:comment "Fréquence anormale de transactions, >10 en 5 min (R004)." ;
                       rdfs:label "Alerte Fraude Fréquence" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeHeure
:AlerteFraudeHeure rdf:type owl:Class ;
                   rdfs:subClassOf :AlerteFraude ;
                   rdfs:comment "Transaction hors heures habituelles, 23h-6h (R003)." ;
                   rdfs:label "Alerte Fraude Heure" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeHistorique
:AlerteFraudeHistorique rdf:type owl:Class ;
                        rdfs:subClassOf :AlerteFraude ;
                        rdfs:comment "Montant supérieur à 3x la moyenne historique du client (R007)." ;
                        rdfs:label "Alerte Fraude Historique" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeLocalisation
:AlerteFraudeLocalisation rdf:type owl:Class ;
                          rdfs:subClassOf :AlerteFraude ;
                          rdfs:comment "Transaction incohérente avec la localisation actuelle du client (R010)." ;
                          rdfs:label "Alerte Fraude Localisation" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#AlerteFraudeMontant
:AlerteFraudeMontant rdf:type owl:Class ;
                     rdfs:subClassOf :AlerteFraude ;
                     rdfs:comment "Montant anormal dépassant le seuil critique (R001)." ;
                     rdfs:label "Alerte Fraude Montant" .


