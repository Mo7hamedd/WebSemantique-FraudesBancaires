#################################################################
#    EXEMPLE D'INSTANCE MISE À JOUR
#    (l'alerte utilise la sous-classe spécifique + :hasAlertEvidence)
#################################################################

:alerte_0197005c a :AlerteFraudeMontant ;
    :alertID "c7a64f89-6570-42f2-9ae6-9df3cdc7c087" ;
    :alertScore "0.83"^^xsd:float ;
    :alertSeverity "Elevee" ;
    :alertStatus "Ouverte" ;
    :alertTimestamp "2026-08-31T14:05:06.011467"^^xsd:dateTime ;
    :triggeredBy :txn_98e8caca ;
    :concernsClient :client_9fc94caa ;
    :concernsAccount :compte_809888dd ;
    :triggersRule :regle_R001 ;
    :hasAlertEvidence :preuve_001 .

:preuve_001 a :Preuve ;
    :evidenceValue 16411.18 ;
    :evidenceThreshold 5000.0 ;
    :evidenceDescription "Montant dépasse le seuil critique" ;
    :evidenceTimestamp "2026-08-31T14:05:06"^^xsd:dateTime ;
    :hasViolatedRule :regle_R001 ;
    :concernsTransaction :txn_98e8caca .
