@prefix : <http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#> .

<http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#appliedTo
:appliedTo rdf:type owl:ObjectProperty ;
           owl:inverseOf :triggersRule ;
           rdfs:domain :Regle ;
           rdfs:range :AlerteFraude .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#belongsTo
:belongsTo rdf:type owl:ObjectProperty ;
           owl:inverseOf :hasAccount ;
           rdfs:domain :CompteBancaire ;
           rdfs:range :Client .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#concernsAccount
:concernsAccount rdf:type owl:ObjectProperty ;
                 rdfs:domain :AlerteFraude ;
                 rdfs:range :CompteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#concernsCard
:concernsCard rdf:type owl:ObjectProperty ;
              rdfs:domain :AlerteFraude ;
              rdfs:range :CarteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#concernsClient
:concernsClient rdf:type owl:ObjectProperty ;
                rdfs:domain :AlerteFraude ;
                rdfs:range :Client .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#concernsLocation
:concernsLocation rdf:type owl:ObjectProperty ;
                  rdfs:domain :AlerteFraude ;
                  rdfs:range :Localisation .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#concernsTransaction
:concernsTransaction rdf:type owl:ObjectProperty ;
                     owl:inverseOf :hasEvidence ;
                     rdfs:domain :Preuve ;
                     rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#destinationOf
:destinationOf rdf:type owl:ObjectProperty ;
               owl:inverseOf :hasDestination ;
               rdfs:domain :CompteBancaire ;
               rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#generatesAlert
:generatesAlert rdf:type owl:ObjectProperty ;
                owl:inverseOf :triggeredBy ;
                rdfs:domain :Transaction ;
                rdfs:range :AlerteFraude .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasAccount
:hasAccount rdf:type owl:ObjectProperty ;
            rdfs:domain :Client ;
            rdfs:range :CompteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasAlertEvidence
:hasAlertEvidence rdf:type owl:ObjectProperty ;
                  rdfs:domain :AlerteFraude ;
                  rdfs:range :Preuve ;
                  rdfs:comment "Relie une alerte de fraude à une preuve. Distincte de :hasEvidence (Transaction -> Preuve)." ;
                  rdfs:label "possède une preuve (alerte)" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasCard
:hasCard rdf:type owl:ObjectProperty ;
         owl:inverseOf :linkedTo ;
         rdfs:domain :CompteBancaire ;
         rdfs:range :CarteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasCurrentLocation
:hasCurrentLocation rdf:type owl:ObjectProperty ;
                    owl:inverseOf :isCurrentLocationOf ;
                    rdfs:domain :Client ;
                    rdfs:range :Localisation .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasDestination
:hasDestination rdf:type owl:ObjectProperty ;
                rdfs:domain :Transaction ;
                rdfs:range :CompteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasEvidence
:hasEvidence rdf:type owl:ObjectProperty ;
             rdfs:domain :Transaction ;
             rdfs:range :Preuve ;
             rdfs:comment "Relie une transaction à une preuve. Propriété séparée de :hasAlertEvidence (correction OWL 2 DL)." ;
             rdfs:label "possède une preuve (transaction)" .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             owl:inverseOf :locationOf ;
             rdfs:domain :Transaction ;
             rdfs:range :Localisation .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasSource
:hasSource rdf:type owl:ObjectProperty ;
           owl:inverseOf :sourceOf ;
           rdfs:domain :Transaction ;
           rdfs:range :CompteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasUsualLocation
:hasUsualLocation rdf:type owl:ObjectProperty ;
                  owl:inverseOf :isUsualLocationOf ;
                  rdfs:domain :Client ;
                  rdfs:range :Localisation .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#hasViolatedRule
:hasViolatedRule rdf:type owl:ObjectProperty ;
                 rdfs:domain :Preuve ;
                 rdfs:range :Regle .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#involvesTransactions
:involvesTransactions rdf:type owl:ObjectProperty ;
                      rdfs:domain :AlerteFraude ;
                      rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#isCurrentLocationOf
:isCurrentLocationOf rdf:type owl:ObjectProperty ;
                     rdfs:domain :Localisation ;
                     rdfs:range :Client .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#isUsualLocationOf
:isUsualLocationOf rdf:type owl:ObjectProperty ;
                   rdfs:domain :Localisation ;
                   rdfs:range :Client .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#linkedTo
:linkedTo rdf:type owl:ObjectProperty ;
          rdfs:domain :CarteBancaire ;
          rdfs:range :CompteBancaire .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#locationOf
:locationOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Localisation ;
            rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#relatedTransaction
:relatedTransaction rdf:type owl:ObjectProperty ,
                             owl:SymmetricProperty ;
                    rdfs:domain :Transaction ;
                    rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#sourceOf
:sourceOf rdf:type owl:ObjectProperty ;
          rdfs:domain :CompteBancaire ;
          rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#triggeredBy
:triggeredBy rdf:type owl:ObjectProperty ;
             rdfs:domain :AlerteFraude ;
             rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#triggersRule
:triggersRule rdf:type owl:ObjectProperty ;
              rdfs:domain :AlerteFraude ;
              rdfs:range :Regle .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#usedIn
:usedIn rdf:type owl:ObjectProperty ;
        owl:inverseOf :usesCard ;
        rdfs:domain :CarteBancaire ;
        rdfs:range :Transaction .


###  http://www.semanticweb.org/dell/ontologies/2026/7/Fraude-bancaires-corrigee#usesCard
:usesCard rdf:type owl:ObjectProperty ;
          rdfs:domain :Transaction ;
          rdfs:range :CarteBancaire .


